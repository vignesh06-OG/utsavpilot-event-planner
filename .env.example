# UtsavPilot Environment Configuration Example
# Copy this file to .env and configure your Google Gemini API key.
# If no key is set, UtsavPilot automatically runs in 100% resilient Deterministic Fallback Mode.

# Server Port (default 3001)
PORT=3001

# Google Gemini API Key (keep server-side only; never expose in client bundles)
GEMINI_API_KEY=your_gemini_api_key_here

# Node Environment
NODE_ENV=development
